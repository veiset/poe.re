{
  "name": "poe.re",
  "version": "0.1.0",
  "homepage": "https://poe.re",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": "https://github.com/veiset/poe.re.git",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/manrope": "^5.3.0",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "dev": "vite",
    "dev:poe2": "vite --config vite.config.poe2.ts",
    "build": "pnpm run typecheck && pnpm run build:poe && pnpm run build:poe2",
    "build:poe": "vite build --config vite.config.poe.ts",
    "build:poe2": "vite build --config vite.config.poe2.ts",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "preview:poe2": "vite preview --config vite.config.poe2.ts",
    "test": "vitest run",
    "fetch-typedefs": "node scripts/fetch-typedefs.ts"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "~8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
