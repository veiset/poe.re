{
  "name": "poe.re",
  "version": "0.1.0",
  "homepage": "https://poe.re",
  "private": true,
  "type": "module",
  "repository": "https://github.com/veiset/poe.re.git",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/manrope": "^4.5.12",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "react-search-autocomplete": "^8.5.2",
    "typescript": "^5.7.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "vite",
    "dev:poe2": "vite --config vite.config.poe2.ts",
    "build": "pnpm run typecheck && pnpm run build:poe && pnpm run build:poe2",
    "build:poe": "vite build --config vite.config.poe.ts",
    "build:poe2": "vite build --config vite.config.poe2.ts",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "preview:poe2": "vite preview --config vite.config.poe2.ts",
    "test": "vitest run",
    "fetch-trade-stats": "pnpm exec ts-node --esm --project scripts/tsconfig.json scripts/fetch-trade-stats.ts"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "ts-node": "^10.9.2",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
